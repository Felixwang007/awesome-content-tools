s.githubusercontent.com/u/315718458?"},"repo":{"id":1423101235,"name":"Gathin23/cleanyourtv","url":"https://api.github.com/repos/Gathin23/cleanyourtv"},"payload":{"action":"started"},"public":true,"created_at":"2026-10-21T05:59:43Z"},{"id":"17782022999","type":"IssuesEvent","actor":{"id":163815440,"login":"wilsonsamiano","display_login":"wilsonsamiano","gravatar_id":"","url":"https://api.github.com/users/wilsonsamiano","avatar_url":"https://avatars.githubusercontent.com/u/163815440?"},"repo":{"id":1423101235,"name":"Gathin23/cleanyourtv","url":"https://api.github.com/repos/Gathin23/cleanyourtv"},"payload":{"action":"opened","issue":{"url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577","repository_url":"https://api.github.com/repos/Gathin23/cleanyourtv","labels_url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577/labels{/name}","comments_url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577/comments","events_url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577/events","html_url":"https://github.com/Gathin23/cleanyourtv/issues/577","id":5955219093,"node_id":"I_kwDOVNLNM88AAAABYvVulQ","number":577,"title":"Device reports: TVision Hub + onn 4K Pro (launcher as Home ✓), Fire TV Stick 4K (debloat ✓), Fire TV Box 2015 (debloat blocked by firmware)","user":{"login":"wilsonsamiano","id":163815440,"node_id":"U_kgDOCcOgEA","avatar_url":"https://avatars.githubusercontent.com/u/163815440?v=4","gravatar_id":"","url":"https://api.github.com/users/wilsonsamiano","html_url":"https://github.com/wilsonsamiano","followers_url":"https://api.github.com/users/wilsonsamiano/followers","following_url":"https://api.github.com/users/wilsonsamiano/following{/other_user}","gists_url":"https://api.github.com/users/wilsonsamiano/gists{/gist_id}","starred_url":"https://api.github.com/users/wilsonsamiano/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/wilsonsamiano/subscriptions","organizations_url":"https://api.github.com/users/wilsonsamiano/orgs","repos_url":"https://api.github.com/users/wilsonsamiano/repos","events_url":"https://api.github.com/users/wilsonsamiano/events{/privacy}","received_events_url":"https://api.github.com/users/wilsonsamiano/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-21T05:59:38Z","updated_at":"2026-10-21T05:59:38Z","closed_at":null,"assignee":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Field report from one session (Oct 20, 2026) across six devices, same-session results only. Launcher built on Linux (CachyOS) with Temurin JDK 17 + Android SDK platform 34 in the home directory, using Google platform-tools `adb`.\n\n## Worked\n\n**TVision Hub (SEI Robotics Google TV dongle, Amlogic S905X2, T-Mobile operator layer)**\n- ADB would not connect until the TV was restarted; fine after that.\n- Disabled 7: `com.nes.tvbugtracker`, `com.nes.tv.bugreportsender`, `com.google.android.tvrecommendations`, `com.sei.hitv.explore`, `com.google.android.videos`, `com.android.camera2`, `com.google.android.play.games`.\n- Launcher built and installed as Home; confirmed clean home screen. First build run hung at the TV-connect step; re-running after `adb disconnect` succeeded.\n\n**onn 4K Pro (\"gretzky\", Google TV)**\n- Stock Home is `com.google.android.apps.tv.launcherx`, which the installer recognizes.\n- Disabled: `com.onn.tv.setup.customization`, `com.google.android.play.games`, `com.android.tv.feedbackconsent`, `com.android.adservices.api`.\n- **Key finding:** the first install rolled back because `com.google.android.tungsten.setupwraith` claimed Home. Disabling `setupwraith` fixed it — Home now resolves to `com.gathin.tvhome/.MainActivity`.\n\n**Fire TV Stick 4K (\"mantis\", Fire OS 6)** — debloat half only\n- `pm disable-user` works. Disabled 8, including `com.amazon.metrics.api`, `com.amazon.client.metrics.api`, `com.amazon.dp.logger`, `com.amazon.tv.fw.metrics`, `com.amazon.wirelessmetrics.service`, `com.amazon.tv.perfcollection`, and `com.amazon.kso.blackbird` (special-offers engine).\n- 7 packages refuse as protected: `com.amazon.client.metrics`, `com.amazon.device.metrics`, `com.fireos.usagestats.proxy`, `com.amazon.device.logmanager`, `com.amazon.device.crashmanager`, `com.amazon.minerva.client.api`, `com.amazon.ftvads.deeplinking`. Network-level DNS blocking (Pi-hole with the Perflyst AmazonFireTV + SmartTV lists) covers those endpoints instead.\n\n## Didn't work\n\n**Fire TV Box 2015 (\"sloane\", Fire OS 5 / Android 5.1)**\n- Debloat is impossible on this firmware: `pm disable-user` returns SecurityException, `pm uninstall --user 0` returns DELETE_FAILED_INTERNAL_ERROR, and `pm hide` runs but the state never changes. Nothing could be disabled. Fell back to Fire OS privacy toggles plus DNS blocking; some first-party sponsored rows remain regardless.\n\n**Samsung 65\" (Tizen) and Vizio 32\" D32h-G9 (SmartCast)**\n- Not Android, so nothing to run — DNS pointing and built-in privacy toggles only. Listed only so nobody else wastes time trying.","reactions":{"url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/Gathin23/cleanyourtv/issues/577/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}},"public":true,"created_at":"2026-10-21T05:59:39Z"},{"id":"17782019566","type":"ForkEvent","actor":{"id":26090203,"login":"jingjingxinshang","display_login":"jingjingxinshang","gravatar_id":"","url":"https://api.github.com/users/jingjingxinshang","avatar_url":"https://avatars.githubusercontent.com/u/26090203?"},"repo":{"id":1423101235,"name":"